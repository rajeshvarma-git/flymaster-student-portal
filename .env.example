DATABASE_URL=postgresql://flyapp:YOUR_PASSWORD@127.0.0.1:5433/flymasters

# ── Railway production (recommended) ────────────────────────────────────────
# Railway Free/Hobby blocks Gmail SMTP. Use Resend instead (free: 100 emails/day):
# 1. Sign up at https://resend.com
# 2. Create an API key at https://resend.com/api-keys
# 3. Add RESEND_API_KEY to Railway variables
# 4. Verify your domain at https://resend.com/domains and set RESEND_FROM
RESEND_API_KEY=re_your_api_key_here
# Do NOT use @gmail.com here — Resend cannot send from Gmail addresses.
# For testing use onboarding@resend.dev. For production verify your domain first.
RESEND_FROM=Fly AI Pathfinder <onboarding@resend.dev>

# ── Local development (optional Gmail SMTP) ─────────────────────────────────
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
GMAIL_FROM_NAME=Fly AI Pathfinder

# Railway / production: leave VITE_API_URL unset so the browser uses the same origin
# VITE_API_URL=

# Health check: /__db_health should show emailProvider=resend and smtpOk=true

# ── WhatsApp Cloud API (Meta) ───────────────────────────────────────────────
# Open https://developers.facebook.com/apps → your app → WhatsApp → API Setup
# Copy:
#   Temporary/permanent access token  → WHATSAPP_API_KEY  (must start with EAA)
#   Phone number ID                   → WHATSAPP_PHONE_NUMBER_ID  (digits only, not +91...)
# Webhook URL: https://YOUR_DOMAIN/api/whatsapp/webhook
# Check config: GET /__db_health  → whatsapp.ok should be true
WHATSAPP_PROVIDER=meta
WHATSAPP_API_KEY=EAAxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose-a-long-random-string
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_OTP_TEMPLATE_NAME=flymasters_otp
# Alias also accepted: WHATSAPP_OTP_TEMPLATE=flymasters_otp
# WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
# WHATSAPP_OTP_TEMPLATE_BUTTON=true
# WHATSAPP_OTP_BUTTON_TYPE=url
# WHATSAPP_API_VERSION=v21.0
