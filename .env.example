DATABASE_URL=postgresql://flyapp:YOUR_PASSWORD@127.0.0.1:5433/flymasters

# Gmail verification for student sign-up (use a Google App Password, not your normal password)
# Required on Railway for sign-up to work in production.
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
GMAIL_FROM_NAME=Fly AI Pathfinder

# If port 587 fails on Railway, try:
# SMTP_PORT=465
# SMTP_SECURE=true

# Railway / production: leave VITE_API_URL unset so the browser uses the same origin
# (https://your-app.up.railway.app). Only set this for Capacitor mobile builds.
# VITE_API_URL=

# After deploy, verify health at /__db_health:
# emailConfigured=true and smtpOk=true means email sending will work.
